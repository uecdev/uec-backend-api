APP_NAME="UEC"
APP_ENV=production
APP_KEY=                       # php artisan key:generate (SAME key on API and admin servers)
APP_DEBUG=false
APP_URL=https://api.domainname.org
APP_TIMEZONE=UTC

UEC_SURFACE=api                # admin on app.<domain>; all only for local development
UEC_API_URL=https://api.domainname.org     # used to build the payment callback URL
UEC_ADMIN_URL=https://app.domainname.org
UEC_PRIVATE_DISK=s3            # hymn audio, solfa scans, feedback attachments
UEC_PUBLIC_DISK=public         # avatars when Cloudinary is not configured

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=uec_api
DB_USERNAME=uec_api
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=app.domainname.org   # host-only cookie for the dashboard
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=uec_

REDIS_CLIENT=predis            # phpredis is faster if the extension is installed
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=zeptomail          # use "log" locally
MAIL_FROM_ADDRESS="no-reply@domainname.org"
MAIL_FROM_NAME="United Evangelical Church"

ADMIN_EMAIL=
ADMIN_PASSWORD=
